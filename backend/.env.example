# Copy to backend/.env and adjust. Never commit the real .env.
PORT=5000
# Interface to bind. 0.0.0.0 (the default) makes the API reachable from other laptops on the LAN.
HOST=0.0.0.0
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Allowed browser origins, comma-separated. Ignored (any origin allowed) when LOGSENTINEL_DEMO_MODE=true.
CLIENT_URL=http://localhost:5173

# --- LogSentinel demo integration (leave LOGSENTINEL_URL empty to disable it entirely) ---
# Base URL of the LogSentinel API. Use Laptop 2's LAN IPv4 address, not 127.0.0.1.
LOGSENTINEL_URL=http://LAPTOP_2_LAN_IP:8000
# Asset this store reports as; must match the asset LogSentinel contains IPs for.
LOGSENTINEL_ASSET_ID=demo-store
# Shared secret sent as X-Demo-Control-Token on denylist checks; must match LogSentinel's value.
LOGSENTINEL_CONTROL_TOKEN=shared-demo-secret
# true = trust the X-Demo-Source-IP header as the client IP (controlled demo only) and allow any CORS origin.
# false/unset = use the real socket IP.
LOGSENTINEL_DEMO_MODE=true
